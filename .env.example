# Copy this file to .env.local and fill in the values from your Supabase project.
# Find both under: Supabase dashboard → Project Settings → API.
# The anon key is safe to ship to the browser (it's gated by Row-Level Security).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NOTE: the Anthropic API key is NO LONGER a client env var. The AI assistant
# routes through the `anthropic-proxy` Supabase Edge Function, which holds the
# key server-side. Set it once with the Supabase CLI:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
# See supabase/functions/anthropic-proxy/index.ts for deploy steps.
