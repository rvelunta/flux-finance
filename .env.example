# Copy this file to .env.local and fill in the values from your Supabase project.
# Find both under: Supabase dashboard → Project Settings → API.
# The anon key is safe to ship to the browser (it's gated by Row-Level Security).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Anthropic API key for the conversational AI input mode.
# PROTOTYPE ONLY: this key is bundled into the browser app. For shipping,
# move calls behind a small proxy that holds the key server-side.
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...
